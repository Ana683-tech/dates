generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  telefono  String?
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@map("clientes")
}